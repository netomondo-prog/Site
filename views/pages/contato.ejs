<%- include('../partials/head') %>
<%- include('../partials/page-hero', { title: 'Contato', subtitle: 'Fale com a equipe técnica e comercial da JTEC. Respondemos em até 24 horas úteis.', breadcrumbs: [{ label: 'Contato' }] }) %>

<%
  const UFS = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];
  const v = values || {};
%>

<section class="section">
  <div class="container contact-grid">
    <div class="contact-grid__info">
      <div class="contact-card">
        <span class="contact-card__icon"><%- include('../partials/icon', { name: 'whatsapp' }) %></span>
        <div>
          <h3>WhatsApp</h3>
          <a href="<%= whatsappLink() %>" target="_blank" rel="noopener"><%= text.formatPhone(site.whatsapp) %></a>
          <p>Resposta rápida em horário comercial</p>
        </div>
      </div>
      <div class="contact-card">
        <span class="contact-card__icon"><%- include('../partials/icon', { name: 'phone' }) %></span>
        <div>
          <h3>Telefone</h3>
          <a href="tel:<%= site.phone.replace(/[^\d+]/g, '') %>"><%= site.phone %></a>
          <% if (site.phoneAlt) { %><a href="tel:<%= site.phoneAlt.replace(/[^\d+]/g, '') %>"><%= site.phoneAlt %></a><% } %>
          <p><%= site.emergency %></p>
        </div>
      </div>
      <div class="contact-card">
        <span class="contact-card__icon"><%- include('../partials/icon', { name: 'mail' }) %></span>
        <div>
          <h3>E-mail</h3>
          <a href="mailto:<%= site.email %>"><%= site.email %></a>
          <p>Orçamentos, dúvidas técnicas e parcerias</p>
        </div>
      </div>
      <div class="contact-card">
        <span class="contact-card__icon"><%- include('../partials/icon', { name: 'pin' }) %></span>
        <div>
          <h3>Endereço</h3>
          <p><%= site.address.street %><br><%= site.address.district %>, <%= site.address.city %>/<%= site.address.state %><br>CEP <%= site.address.zip %></p>
          <p><%= site.hours %></p>
        </div>
      </div>
    </div>

    <div class="contact-grid__form">
      <% if (sent) { %>
        <div class="alert alert--success" role="status">
          <strong>Mensagem enviada!</strong> Recebemos o seu contato e responderemos em até 24 horas úteis. Se for urgente, fale conosco pelo <a href="<%= whatsappLink() %>" target="_blank" rel="noopener">WhatsApp</a>.
        </div>
      <% } %>
      <h2 class="form__title">Envie sua mensagem</h2>
      <p class="form__lead">Para orçamentos de manutenção, informe o tag, modelo, tamanho, pressão de ajuste e fluido da válvula.</p>
      <form class="form" method="post" action="/contato" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="form__hp" aria-hidden="true"><label>Não preencha<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
        <div class="form__row">
          <div class="field<%= errors.name ? ' has-error' : '' %>">
            <label for="name">Nome*</label>
            <input id="name" name="name" type="text" value="<%= v.name || '' %>" required autocomplete="name">
            <% if (errors.name) { %><span class="field__error"><%= errors.name %></span><% } %>
          </div>
          <div class="field<%= errors.email ? ' has-error' : '' %>">
            <label for="email">E-mail*</label>
            <input id="email" name="email" type="email" value="<%= v.email || '' %>" required autocomplete="email">
            <% if (errors.email) { %><span class="field__error"><%= errors.email %></span><% } %>
          </div>
        </div>
        <div class="form__row">
          <div class="field">
            <label for="company">Empresa</label>
            <input id="company" name="company" type="text" value="<%= v.company || '' %>" autocomplete="organization">
          </div>
          <div class="field<%= errors.phone ? ' has-error' : '' %>">
            <label for="phone">Telefone / WhatsApp*</label>
            <input id="phone" name="phone" type="tel" value="<%= v.phone || '' %>" required autocomplete="tel" placeholder="(19) 99999-0000" data-mask="phone">
            <% if (errors.phone) { %><span class="field__error"><%= errors.phone %></span><% } %>
          </div>
        </div>
        <div class="form__row">
          <div class="field">
            <label for="city">Cidade</label>
            <input id="city" name="city" type="text" value="<%= v.city || '' %>" autocomplete="address-level2">
          </div>
          <div class="field field--sm">
            <label for="state">Estado</label>
            <select id="state" name="state">
              <option value="">UF</option>
              <% UFS.forEach((uf) => { %><option value="<%= uf %>"<%= v.state === uf ? ' selected' : '' %>><%= uf %></option><% }) %>
            </select>
          </div>
          <div class="field<%= errors.subject ? ' has-error' : '' %>">
            <label for="subject">Assunto*</label>
            <select id="subject" name="subject" required>
              <option value="">Selecione</option>
              <% subjects.forEach((s) => { %><option value="<%= s %>"<%= v.subject === s ? ' selected' : '' %>><%= s %></option><% }) %>
            </select>
            <% if (errors.subject) { %><span class="field__error"><%= errors.subject %></span><% } %>
          </div>
        </div>
        <div class="field<%= errors.message ? ' has-error' : '' %>">
          <label for="message">Mensagem*</label>
          <textarea id="message" name="message" rows="6" required placeholder="Ex.: PSV tag PSV-1201, 2x3 J, ajuste 150 psig, vapor. Preciso de teste e RTS para a parada de outubro."><%= v.message || '' %></textarea>
          <% if (errors.message) { %><span class="field__error"><%= errors.message %></span><% } %>
        </div>
        <div class="form__actions">
          <button class="btn btn--primary btn--lg" type="submit">Enviar mensagem</button>
          <span class="form__privacy">Seus dados são usados apenas para responder ao contato.</span>
        </div>
      </form>
    </div>
  </div>
</section>

<section class="map">
  <iframe
    title="Mapa com a localização da JTEC"
    src="https://www.google.com/maps?q=<%= encodeURIComponent(site.address.mapsQuery || (site.address.street + ', ' + site.address.city)) %>&output=embed"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen></iframe>
  <div class="container map__bar">
    <span><%= site.address.street %>, <%= site.address.district %>, <%= site.address.city %>/<%= site.address.state %></span>
    <a class="link-arrow" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(site.address.mapsQuery || (site.address.street + ', ' + site.address.city)) %>" target="_blank" rel="noopener">Abrir no Google Maps <%- include('../partials/icon', { name: 'external', cls: 'icon icon--sm' }) %></a>
  </div>
</section>

<%- include('../partials/foot') %>
