<%
  // Logotipo JTECK Valve Service (SVG vetorial). variant: 'dark' (padrão) | 'light'
  const v = typeof variant !== 'undefined' ? variant : 'dark';
  const blue = v === 'light' ? '#ffffff' : '#1b4b9c';
  const gray = v === 'light' ? '#b9c3d3' : '#8c8c8c';
  const uid = 'lg' + Math.random().toString(36).slice(2, 7);
%>
<svg class="logo logo--<%= v %>" viewBox="0 0 1000 250" role="img" aria-label="JTECK Valve Service" xmlns="http://www.w3.org/2000/svg">
  <defs><clipPath id="<%= uid %>"><rect x="790" y="25" width="170" height="140"/></clipPath></defs>
  <g fill="none" stroke="<%= blue %>" stroke-width="40">
    <path d="M145 25V118Q145 145 118 145H50Q30 145 30 125V110"/>
  </g>
  <g fill="<%= blue %>">
    <rect x="185" y="25" width="185" height="40"/>
    <rect x="257" y="25" width="40" height="140"/>
  </g>
  <g fill="<%= gray %>">
    <rect x="395" y="25" width="175" height="37"/>
    <rect x="395" y="76.5" width="175" height="37"/>
    <rect x="395" y="128" width="175" height="37"/>
    <rect x="790" y="25" width="40" height="140"/>
  </g>
  <g fill="none" stroke="<%= gray %>" stroke-width="40">
    <path d="M765 45H660Q620 45 620 85V105Q620 145 660 145H765"/>
    <g clip-path="url(#<%= uid %>)"><path d="M835 95L980 0M835 95L980 190"/></g>
  </g>
  <text x="30" y="232" textLength="930" lengthAdjust="spacingAndGlyphs" font-family="Inter, 'Segoe UI', Arial, sans-serif" font-weight="600" font-size="46" letter-spacing="12" fill="<%= blue %>">VALVE SERVICE</text>
</svg>
