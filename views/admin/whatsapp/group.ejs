<%- include('../_head', { title: 'Grupo: ' + title, actions: '<a class="btn btn--sm btn--outline" href="/admin/whatsapp/grupos/' + group.id + '/exportar">Exportar CSV</a> <a class="btn btn--sm btn--primary" href="/admin/whatsapp/campanhas/nova?grupo=' + group.id + '">Disparar para este grupo</a>' }) %>
<%- include('_nav') %>

<div class="tiles tiles--3">
  <div class="tile"><span class="tile__value"><%= total %></span><span class="tile__label">Contatos no grupo</span></div>
  <div class="tile"><span class="tile__value"><%= total - optOut %></span><span class="tile__label">Aptos a receber</span></div>
  <div class="tile tile--accent"><span class="tile__value"><%= optOut %></span><span class="tile__label">Descadastrados</span></div>
</div>

<% if (importResult) { %>
  <div class="panel">
    <h2 class="panel__title">Resultado da importação</h2>
    <p><strong><%= importResult.added %></strong> novos · <strong><%= importResult.updated %></strong> já existentes (adicionados a este grupo) · <strong><%= importResult.duplicates %></strong> repetidos na lista · <strong><%= importResult.invalidCount %></strong> inválidos</p>
    <% if (importResult.invalid.length) { %><p class="muted">Inválidos: <%= importResult.invalid.join(', ') %><%= importResult.invalidCount > importResult.invalid.length ? '…' : '' %></p><% } %>
  </div>
<% } %>

<div class="grid-2">
  <form class="panel form form--admin" method="post" action="/admin/whatsapp/grupos/<%= group.id %>/importar" enctype="multipart/form-data">
    <h2 class="panel__title">Subir lista</h2>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field">
      <label for="lista">Arquivo CSV</label>
      <input id="lista" name="lista" type="file" accept=".csv,.txt,text/csv">
      <small class="help">Salve a planilha como CSV. Colunas: <code>telefone</code> (obrigatória), <code>nome</code> e quaisquer outras (ex.: <code>empresa</code>, <code>cidade</code>), que viram variáveis <code>{empresa}</code> nas mensagens. Números sem DDI recebem +55.</small>
    </div>
    <div class="field">
      <label for="colar">…ou cole a lista</label>
      <textarea id="colar" name="colar" rows="5" placeholder="telefone;nome;empresa&#10;19999990000;Maria Silva;Usina X&#10;(11) 98888-7777;João;Química Y"></textarea>
    </div>
    <button class="btn btn--primary" type="submit">Importar para o grupo</button>
    <p class="help">Importe apenas contatos que autorizaram receber mensagens da empresa pelo WhatsApp (exigência da Meta e da LGPD).</p>
  </form>

  <div>
    <form class="panel form form--admin" method="post" action="/admin/whatsapp/grupos/<%= group.id %>/contato">
      <h2 class="panel__title">Adicionar contato</h2>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="form__row">
        <div class="field"><label for="c-phone">Telefone*</label><input id="c-phone" name="phone" type="text" required placeholder="(19) 99999-0000"></div>
        <div class="field"><label for="c-name">Nome</label><input id="c-name" name="name" type="text"></div>
      </div>
      <button class="btn btn--outline" type="submit">Adicionar</button>
    </form>

    <form class="panel form form--admin" method="post" action="/admin/whatsapp/grupos/<%= group.id %>">
      <h2 class="panel__title">Dados do grupo</h2>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="e-name">Nome</label><input id="e-name" name="name" type="text" value="<%= group.name %>" required></div>
      <div class="field"><label for="e-desc">Descrição</label><input id="e-desc" name="description" type="text" value="<%= group.description || '' %>"></div>
      <button class="btn btn--outline" type="submit">Salvar</button>
    </form>
  </div>
</div>

<div class="panel">
  <div class="panel__head">
    <h2>Contatos</h2>
    <form class="inline-search" method="get">
      <input type="search" name="q" value="<%= q %>" placeholder="Buscar nome ou telefone">
      <button class="btn btn--sm btn--outline" type="submit">Buscar</button>
    </form>
  </div>
  <% if (contacts.length) { %>
    <form id="remove-form" method="post" action="/admin/whatsapp/grupos/<%= group.id %>/remover" data-confirm="Remover os contatos selecionados deste grupo?">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
    </form>
    <table class="table">
      <thead><tr><th><input type="checkbox" data-check-all="ids" aria-label="Selecionar todos"></th><th>Telefone</th><th>Nome</th><th>Outros dados</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% contacts.forEach((c) => { %>
          <tr>
            <td><input type="checkbox" name="ids" value="<%= c.id %>" form="remove-form"></td>
            <td><%= wa.phone.format(c.phone) %></td>
            <td><%= c.name || '-' %><% if (c.profileName && c.profileName !== c.name) { %><br><small class="muted">WhatsApp: <%= c.profileName %></small><% } %></td>
            <td><small class="muted"><%= Object.entries(c.fields || {}).filter(([, v]) => v).map(([k, v]) => k + ': ' + v).join(' · ') %></small></td>
            <td><span class="status status--<%= c.optOut ? 'off' : 'on' %>"><%= c.optOut ? 'Descadastrado' : 'Ativo' %></span></td>
            <td class="table__actions">
              <form method="post" action="/admin/whatsapp/contatos/<%= c.id %>/optout">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="optOut" value="<%= c.optOut ? 'false' : 'true' %>">
                <button class="btn btn--sm btn--ghost-dark" type="submit"><%= c.optOut ? 'Reativar' : 'Descadastrar' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="muted"><small>Mostrando <%= shown %> de <%= matched %>.</small></p>
    <div class="form__actions">
      <button class="btn btn--sm btn--danger" type="submit" form="remove-form">Remover selecionados do grupo</button>
      <form method="post" action="/admin/whatsapp/grupos/<%= group.id %>/excluir" data-confirm="Excluir o grupo &quot;<%= group.name %>&quot;? Contatos que não estiverem em outro grupo também serão apagados.">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn--sm btn--danger" type="submit">Excluir grupo</button>
      </form>
    </div>
  <% } else { %>
    <p class="muted"><%= q ? 'Nenhum contato encontrado.' : 'Grupo vazio. Suba uma lista acima.' %></p>
    <% if (!q) { %>
      <form method="post" action="/admin/whatsapp/grupos/<%= group.id %>/excluir" data-confirm="Excluir o grupo?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn--sm btn--danger" type="submit">Excluir grupo</button>
      </form>
    <% } %>
  <% } %>
</div>

<%- include('../_foot') %>
