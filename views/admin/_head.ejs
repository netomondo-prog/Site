<%
  const t = typeof title !== 'undefined' ? title : 'Painel';
  const res = typeof resources !== 'undefined' ? resources : {};
  const menu = [
    { href: '/admin', label: 'Início', icon: 'star', exact: true },
    { href: '/admin/servicos', label: 'Serviços', icon: 'valve' },
    { href: '/admin/produtos', label: 'Produtos', icon: 'box' },
    { href: '/admin/blog', label: 'Blog', icon: 'doc' },
    { href: '/admin/segmentos', label: 'Segmentos', icon: 'energy' },
    { href: '/admin/mensagens', label: 'Mensagens', icon: 'inbox' },
    { href: '/admin/configuracoes', label: 'Configurações', icon: 'settings' },
  ];
  const active = (m) => (m.exact ? path === m.href : path.startsWith(m.href));
%><!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= t %> | Painel <%= site.name %></title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<div class="admin">
  <aside class="admin__sidebar">
    <a class="admin__brand" href="/admin"><%- include('../partials/logo', { variant: 'light' }) %></a>
    <nav class="admin__nav">
      <% menu.forEach((m) => { %>
        <a class="admin__link<%= active(m) ? ' is-active' : '' %>" href="<%= m.href %>"><%- include('../partials/icon', { name: m.icon, cls: 'icon icon--sm' }) %> <%= m.label %></a>
      <% }) %>
    </nav>
    <div class="admin__sidebar-foot">
      <a class="admin__link" href="/" target="_blank" rel="noopener"><%- include('../partials/icon', { name: 'external', cls: 'icon icon--sm' }) %> Ver o site</a>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="admin__link admin__link--btn" type="submit"><%- include('../partials/icon', { name: 'logout', cls: 'icon icon--sm' }) %> Sair</button>
      </form>
    </div>
  </aside>
  <div class="admin__main">
    <header class="admin__topbar">
      <h1 class="admin__title"><%= t %></h1>
      <% if (typeof actions !== 'undefined') { %><div class="admin__actions"><%- actions %></div><% } %>
    </header>
    <% if (flash) { %>
      <div class="alert alert--<%= flash.type %>" role="status"><%= flash.message %></div>
    <% } %>
    <div class="admin__content">
