# Porta do servidor
PORT=3000
NODE_ENV=development

# Nome exibido no painel
APP_NAME=Disparo WhatsApp

# Segredo da sessão (troque em produção)
SESSION_SECRET=troque-este-segredo

# Acesso ao painel
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Pasta dos dados (listas, kits, mídias e histórico). Use um disco persistente em produção.
# DATA_DIR=/data

# WhatsApp Cloud API — passo a passo em docs/configurar-numero-api-oficial.md
# Sem TOKEN e PHONE_NUMBER_ID o painel funciona em modo simulação (nada é enviado).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_RATE_PER_SECOND=10
# WHATSAPP_DEFAULT_COUNTRY=55
# WHATSAPP_DRY_RUN=true
