# Porta do servidor
PORT=3000
NODE_ENV=development

# Segredo da sessão (troque em produção)
SESSION_SECRET=troque-este-segredo

# Acesso ao painel administrativo (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=jtec2026

# Envio de e-mail do formulário de contato (opcional).
# Se SMTP_HOST não for informado, as mensagens ficam apenas salvas no painel.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Site JTEC <site@jtec.com.br>"
MAIL_TO=contato@jtec.com.br

# Diretório dos dados (JSON). Útil para volumes persistentes em produção.
# DATA_DIR=/data

# WhatsApp Cloud API (disparo de campanhas em /admin/whatsapp).
# Passo a passo para obter cada valor: docs/whatsapp-api-setup.md
# Sem TOKEN e PHONE_NUMBER_ID o painel funciona em modo simulação.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_RATE_PER_SECOND=10
# WHATSAPP_DRY_RUN=true
